{
  "description": "Mutually exclusive predicates: a=1 AND a=2 can never hold -> exactly 0 rows.",
  "relations": {
    "R": {"columns": {"a": {"domain": [1, 2]}}}
  },
  "statistics": [
    {"id": "R_rows", "type": "row_count", "relation": "R", "count": 2},
    {"id": "R_a_hist", "type": "histogram", "relation": "R", "column": "a", "counts": {"1": 1, "2": 1}},
    {"id": "R_a_nulls", "type": "null_count", "relation": "R", "column": "a", "count": 0}
  ],
  "query": {"type": "select", "from": "R",
            "where": {"op": "and", "args": [{"op": "eq", "column": "a", "value": 1},
                                            {"op": "eq", "column": "a", "value": 2}]}}
}
