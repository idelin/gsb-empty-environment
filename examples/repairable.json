{
  "variables": { "a": true, "b": true, "c": false, "d": false },
  "mutable": { "a": 4, "b": 2, "c": 1 },
  "rules": [
    { "id": "r1", "if": [{ "var": "a", "value": true }], "then": { "var": "b", "value": true } },
    { "id": "r2", "if": [{ "var": "b", "value": true }], "then": { "var": "c", "value": true } },
    { "id": "r3", "if": [{ "var": "c", "value": false }, { "var": "d", "value": false }], "then": { "var": "a", "value": false } }
  ]
}
