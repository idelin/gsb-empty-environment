  "constraints": [
    {"id": "c1", "coeffs": {"x": "1", "y": "1", "z": "-1"}, "op": ">=", "rhs": "0"},
    {"id": "c2", "coeffs": {"x": "1", "y": "-1", "z": "-1"}, "op": "<=", "rhs": "0"},
    {"id": "c3", "coeffs": {"y": "1"}, "op": "<=", "rhs": "2"},
    {"id": "c4", "coeffs": {"x": "1", "z": "-1"}, "op": "<", "rhs": "5"}
  ]
}
