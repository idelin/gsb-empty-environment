{
  "description": "Join with a filter and genuine uncertainty: S has one y=1 row which may sit at x=1 or x=2; R has 3 rows at a=1 and 1 row at a=2. Join count provably in [1, 3].",
  "relations": {
    "R": {"columns": {"a": {"domain": [1, 2]}}},
    "S": {"columns": {"x": {"domain": [1, 2]}, "y": {"domain": [1, 2]}}}
  },
  "statistics": [
    {"id": "R_rows", "type": "row_count", "relation": "R", "count": 4},
    {"id": "R_a_hist", "type": "histogram", "relation": "R", "column": "a", "counts": {"1": 3, "2": 1}},
    {"id": "R_a_nulls", "type": "null_count", "relation": "R", "column": "a", "count": 0},
    {"id": "S_rows", "type": "row_count", "relation": "S", "count": 2},
    {"id": "S_x_hist", "type": "histogram", "relation": "S", "column": "x", "counts": {"1": 1, "2": 1}},
    {"id": "S_y_hist", "type": "histogram", "relation": "S", "column": "y", "counts": {"1": 1, "2": 1}},
    {"id": "S_x_nulls", "type": "null_count", "relation": "S", "column": "x", "count": 0},
    {"id": "S_y_nulls", "type": "null_count", "relation": "S", "column": "y", "count": 0}
  ],
  "query": {"type": "join", "left": "R", "right": "S", "on": [["a", "x"]],
            "where": {"op": "eq", "column": "S.y", "value": 1}}
}
