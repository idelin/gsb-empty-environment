fun count(n) {
  if (n == 0) return frame_id();
  return count(n - 1);
}

fun add_one(n) {
  return 1 + count(n);
}

fun cleanup(n) {
  return try (if (n == 0) return 0; return cleanup(n - 1)) finally print("cleanup " + n);
}

print("tail frame id:", count(100000));
print("physical frames under non-tail call:", add_one(50000));
print("cleanup result:", cleanup(2));
