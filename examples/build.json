{
  "packages": {
    "core": {"version": "2.4.1"},
    "net": {"version": "0.9.0-rc.2"},
    "bridge": {"version": "1.0.0-beta.1"},
    "testkit": {"version": "3.2.7"}
  },
  "nodes": {
    "compile-core": {
      "inputs": [{"package": "core", "version": "2.4.1"}],
      "requires_artifacts": ["core.o", "core.a"]
    },
    "package-net": {
      "inputs": [
        {"package": "net", "version": "0.9.0-rc.2"},
        {"package": "core", "version": "2.4.1"}
      ],
      "requires_artifacts": ["net.tar.gz", "net.tar.gz.sha256"]
    },
    "test-flaky": {
      "inputs": [{"package": "testkit", "version": "3.2.7"}],
      "requires_artifacts": ["report.xml"]
    },
    "ship-bridge": {
      "inputs": [{"package": "bridge", "version": "1.0.0-beta.1"}],
      "requires_artifacts": ["bridge.zip"]
    }
  }
}
