# Rill demo: structural records, read/write variance, explicit extension.

# Read-only parameter: only needs `name`; extra fields are allowed (covariance
# in the read position).
fn describe(readonly r: {name: Str}) {
    print("name: " + r.name)
}

# Writable parameter: mutates through an alias, so the argument type must
# match exactly.
fn bump(writable r: {n: Int}) {
    r.n = r.n + 1
}

# Nested records widen covariantly through readonly positions as well.
fn inner_x(readonly r: {inner: {x: Int}}) {
    print(r.inner.x)
}

var p = {name: "Ada", age: 36}      # wider record ...
describe(p)                          # ... passed to a narrower readonly param
print(p)

var q = {n: 1}
bump(q)                              # exact match, mutation visible to caller
print(q.n)

var card = {name: "Ada"}
extend card.age = 36                 # explicit extension, widens the local type
print(card.age)

var total = 0
var i = 1
while i <= 3 {
    total = total + i
    i = i + 1
}
print(total)

inner_x({inner: {x: 7, y: 9}})       # nested extra field is fine when readonly
