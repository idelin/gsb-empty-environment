{
  "resources": ["lock", "conn"],
  "initial": {"lock": "free", "conn": "closed"},
  "terminals": {"lock": ["free"], "conn": ["closed"]},
  "actions": {
    "acquire": {
      "transitions": [
        {"outcome": "ok", "when": {"lock": "free"}, "set": {"lock": "held"}},
        {"outcome": "fail", "when": {"lock": "held"}, "set": {}}
      ]
    },
    "release": {
      "transitions": [
        {"outcome": "ok", "when": {"lock": "held"}, "set": {"lock": "free"}},
        {"outcome": "fail", "when": {"lock": "free"}, "set": {}}
      ]
    },
    "connect": {
      "transitions": [
        {"outcome": "ok", "when": {"conn": "closed"}, "set": {"conn": "open"}},
        {"outcome": "fail", "when": {"conn": "open"}, "set": {}}
      ]
    },
    "close": {
      "transitions": [
        {"outcome": "ok", "when": {"conn": "open"}, "set": {"conn": "closed"}},
        {"outcome": "fail", "when": {"conn": "closed"}, "set": {}}
      ]
    }
  },
  "scripts": [
    {"name": "A", "actions": ["acquire", "connect", "close", "release"]},
    {"name": "B", "actions": ["connect", "acquire", "release", "close"]}
  ],
  "budget": {"max_states": 100000, "max_depth": 64}
}
