      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test"
  },
  "keywords": [
    "promql",
    "prometheus",
    "rate",
    "increase",
    "irate",
    "counter",
    "stale-nan"
  ],
  "license": "MIT"
}
